# Copy to /etc/scannerd.env, mode 0600 — it holds a token.

PAPERLESS_URL=http://paperless.local:8000
PAPERLESS_TOKEN=

# Everything this rig uploads gets tagged, so one Paperless can serve several
# addresses and the triage surface can tell them apart. By name, separated by
# commas, so a name may contain spaces; the tags must already exist in
# Paperless — a missing one keeps every capture in the spool and says which tag
# it is waiting for.
SCANNERD_TAGS=post,Hauptstraße 12

# The button that finishes a letter of several pages (wiring in the readme).
# Find the device with `ls /dev/input/by-path/` after adding the overlay line.
# Leave it out and every page is its own document.
# SCANNERD_BUTTON=/dev/input/by-path/platform-button@11-event

# The camera sits above a fixed spot, so the crop is a setting rather than
# geometry. x,y,w,h as fractions of the sensor; measure once with
# `rpicam-still -o test.jpg` and a ruler.
# SCANNERD_ROI=0.15,0.10,0.70,0.80

# Anything else, as command-line flags — split on spaces, so nothing with a
# space in it goes here.
# SCANNERD_ARGS=--settle-frames 4 --letter-idle-secs 600
