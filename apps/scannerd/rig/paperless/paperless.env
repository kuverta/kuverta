PAPERLESS_REDIS=redis://broker:6379
PAPERLESS_TIME_ZONE=Europe/Berlin
PAPERLESS_URL=http://scannerpi.local:8010
PAPERLESS_OCR_LANGUAGE=deu+eng
# scannerd straightens every page before sending, so Paperless need not:
# reading a two-page letter went from ~14 s to ~10 s with these.
PAPERLESS_OCR_DESKEW=false
PAPERLESS_OCR_CLEAN=none
PAPERLESS_OCR_OUTPUT_TYPE=pdf
# Never turned a page in 76 (always "no change" or "too unsure"), and cost 5-7 s a page.
PAPERLESS_OCR_ROTATE_PAGES=false
# optimize 0: optimising camera pages never saved anything, and cost ~5 s.
# oversample 300: the photographs are ~200 dpi; 250 or none lost the words
# the folders are matched on.
PAPERLESS_OCR_USER_ARGS={"oversample": 300, "optimize": 0}
# One letter at a time, three of the Pi 4's cores reading its pages side by
# side (5 pages: 163 s -> 76 s), the fourth left for scannerd.
PAPERLESS_WEBSERVER_WORKERS=1
PAPERLESS_TASK_WORKERS=1
PAPERLESS_THREADS_PER_WORKER=3
