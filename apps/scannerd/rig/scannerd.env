# The rig's settings, installed as /etc/scannerd.env by setup.sh every time it
# runs: change them here, not on the Pi. What each one does is in
# ../scannerd.env.example.
#
# The token and the setup page's password are not here. They are in
# /etc/scannerd.secrets on the Pi (mode 0600), which setup.sh creates empty
# and never overwrites. What the setup page saves (crop, corners, tags, the
# folders' words) is data, in the spool's settings.toml, and wins over these.

# Paperless runs on the rig itself, in ./paperless.
PAPERLESS_URL=http://localhost:8010

SCANNERD_UI=0.0.0.0:8080
SCANNERD_FOLDERS=Car,House,Work,Lawstuff,Taxes,-Throw away

# The 3.5" SPI LCD (the piscreen overlay in config.txt) and its touchscreen,
# which scannerd polls itself.
SCANNERD_DISPLAY=/dev/fb0
SCANNERD_TOUCH=/dev/spidev0.1
# The panel is turned round (rotate=270), so the touch runs bottom to top.
SCANNERD_TOUCH_ROWS=x:4000:204

# White paper washes out at the OV5647's own exposure.
SCANNERD_EV=-2
